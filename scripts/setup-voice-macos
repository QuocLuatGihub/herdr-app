#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
[[ $(uname -s) == Darwin ]] || exit 1
voice="$HOME/.local/share/herdr-voice"
mkdir -p "$voice/models" "$voice/jobs"
chmod 700 "$voice/jobs"
if ! [[ -x /opt/homebrew/bin/whisper-cli ]]; then
  brew install whisper-cpp
fi
if ! [[ -f "$voice/models/ggml-small-q5_1.bin" ]]; then
  curl -fL --retry 2 https://huggingface.co/ggerganov/whisper.cpp/resolve/5359861c739e955e79d9a303bcbc70fb988958b1/ggml-small-q5_1.bin -o "$voice/models/ggml-small-q5_1.bin.partial"
  mv "$voice/models/ggml-small-q5_1.bin.partial" "$voice/models/ggml-small-q5_1.bin"
fi
printf '%s  %s\n' ae85e4a935d7a567bd102fe55afc16bb595bdb618e11b2fc7591bc08120411bb "$voice/models/ggml-small-q5_1.bin" | shasum -a 256 -c -
python3 - <<'PY'
import pathlib, plistlib
p = pathlib.Path.home() / '.local/share/herdr-voice/recorder-info.plist'
p.write_bytes(plistlib.dumps(dict(CFBundleIdentifier='vn.quocluat.herdr.voice-recorder', CFBundleName='Herdr Voice',
    NSMicrophoneUsageDescription='Record your voice locally to draft a message for the terminal you select.')))
PY
swiftc custom/voice/Recorder.swift -o "$voice/herdr-recorder.new" -framework AVFoundation \
  -Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker "$voice/recorder-info.plist"
codesign --force --sign - "$voice/herdr-recorder.new"
mv "$voice/herdr-recorder.new" "$voice/herdr-recorder"
cp custom/voice/voice.py "$voice/voice.py.new"
mv "$voice/voice.py.new" "$voice/voice.py"
chmod 700 "$voice/voice.py" "$voice/herdr-recorder"
python3 - <<'PY'
import pathlib, json, shutil
root = pathlib.Path.cwd()
app_home = pathlib.Path.home() / '.config/herdr-app-custom'
for source, name in (('mod', 'voice'), ('toggle', 'voice-toggle')):
    mod = app_home / 'mods' / name
    mod.mkdir(parents=True, exist_ok=True)
    for file in ('main.js', 'mod.json'):
        shutil.copy2(root / 'custom/voice' / source / file, mod / file)
layout = json.loads((root / 'defaults/layouts/main.json').read_text())
layout['children'][1]['children'][1]['children'].append(dict(
    id='voice-panel', type='block', size={'px': 390}, min=340, max=640, content={'mod': 'voice'}))
status = layout['children'][1]['children'][-1]
layout['children'][1]['children'][-1] = dict(id='status-row', type='row', size={'px': 28}, children=[
    {k: v for k, v in status.items() if k != 'size'},
    dict(id='voice-toggle', type='block', size={'px': 115}, content={'mod': 'voice-toggle'})])
(app_home / 'layouts').mkdir(exist_ok=True)
(app_home / 'layouts/voice-custom.json').write_text(json.dumps(layout, indent=2) + '\n')
keys_file = app_home / 'keys.json'
keys = json.loads(keys_file.read_text()) if keys_file.exists() else json.loads((root / 'defaults/keys.macos.json').read_text())
keys.setdefault('global', {}).setdefault('cmd-shift-v', 'voice.record')
keys.setdefault('global', {}).setdefault('cmd-alt-v', 'layout.toggle:voice-panel')
keys_file.write_text(json.dumps(keys, indent=2) + '\n')
PY
python3 custom/agents/install.py
"$voice/herdr-recorder" --check
"$voice/herdr-recorder" --self-test
/usr/bin/python3 "$voice/voice.py" check
